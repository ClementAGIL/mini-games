{
  "name": "mini-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check src",
    "format": "prettier --write src",
    "preview": "vite preview --host",
    "android": "npm run build && npx cap sync android",
    "apk": "npm run android && cd android && .\\gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  }
}
